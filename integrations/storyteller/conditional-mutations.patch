+// The authorization wrapper uses the same asynchronous handler contract as
+// the other API routes even though this response needs no I/O.
+export const GET = withHasPermission("bookList")(
+  // eslint-disable-next-line @typescript-eslint/require-await
+  async () =>
+    new Response(null, {
+      status: 204,
+      headers: {
+        "Storyteller-Conditional-Create": "ifBookMissing-v1",
+        "Storyteller-Conditional-Replace": "ifAssetMissing-v1",
+        "Storyteller-Identifier-Concurrency": "etag-v1",
+        "Cache-Control": "no-store",
+      },
+    }),
+)
