diff --git a/applications/web/src/assets/library/scanner/conditionalMutation.ts b/applications/web/src/assets/library/scanner/conditionalMutation.ts
new file mode 100644
index 00000000..1d6feebc
--- /dev/null
+++ b/applications/web/src/assets/library/scanner/conditionalMutation.ts
@@ -0,0 +1,19 @@
+import { createHash } from "node:crypto"
+
+export class ConditionalMutationConflict extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = "ConditionalMutationConflict"
+  }
+}
+
+export function identifierETag(values: readonly unknown[]): string {
+  // Database row order is not part of identifier state. Sorting the serialized
+  // rows keeps the validator stable when an equivalent query returns them in a
+  // different order.
+  const body = values
+    .map((value) => JSON.stringify(value))
+    .sort()
+    .join("\n")
+  return `"${createHash("sha256").update(body).digest("hex")}"`
+}
