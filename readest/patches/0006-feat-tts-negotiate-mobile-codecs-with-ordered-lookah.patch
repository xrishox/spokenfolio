+import type {
+  OpenAITTSAudioData,
+  OpenAITTSPayload,
+  OpenAITTSResponseFormat,
+} from '@/libs/openaiTTS';
+
+export const OPENAI_TTS_FORMAT_ORDER: readonly OpenAITTSResponseFormat[] = ['opus', 'aac', 'wav'];
+const CODEC_PROBE_TIMEOUT_MS = 2000;
+
+// Valid, deterministic, mono probe files generated from a 440 Hz tone. Opus
+// and WAV use FFmpeg 8.1; AAC uses Apple's afconvert because WebKit rejected
+// the smaller FFmpeg-authored M4A during real-browser validation. They are
+// deliberately embedded so probing works offline and in every Readest shell
+// through the exact AudioContext.decodeAudioData path used for real speech.
+// The files are Ogg Opus (312 B), AAC-LC/M4A (4692 B), and
+// PCM16 WAV (364 B).
+// biome-ignore format: Keep generated fixture payloads visually separate.
+const PROBE_BASE64: Record<OpenAITTSResponseFormat, string> = {
+  opus:
+    '',
+  aac:
+    '',
+  wav:
+    '',
+};
+
+export const getOpenAITTSProbeData = (format: OpenAITTSResponseFormat): ArrayBuffer => {
+  const binary = globalThis.atob(PROBE_BASE64[format]);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+};
+
+export class OpenAITTSCodecExhaustedError extends Error {
+  constructor() {
+    super('This runtime or speech server could not provide a decodable Opus, AAC, or WAV stream.');
+    this.name = 'OpenAITTSCodecExhaustedError';
+  }
+}
+
+type ProbeDecoder = (data: ArrayBuffer) => Promise<unknown>;
+
+// One negotiator is owned by one OpenAITTSClient endpoint session. Rejections
+// only move forward, so concurrent lookahead jobs can never re-enable a codec
+// that another job has already proved unusable.
+export class OpenAITTSCodecNegotiator {
+  readonly #decode: ProbeDecoder;
+  readonly #probeResults = new Map<OpenAITTSResponseFormat, Promise<boolean>>();
+  #minimumIndex = 0;
+  #pinnedFormat: OpenAITTSResponseFormat | null = null;
+
+  constructor(decode: ProbeDecoder) {
+    this.#decode = decode;
+  }
+
+  get pinnedFormat(): OpenAITTSResponseFormat | null {
+    return this.#pinnedFormat;
+  }
+
+  get minimumFormat(): OpenAITTSResponseFormat | null {
+    return OPENAI_TTS_FORMAT_ORDER[this.#minimumIndex] ?? null;
+  }
+
+  accepts(format: OpenAITTSResponseFormat): boolean {
+    const index = OPENAI_TTS_FORMAT_ORDER.indexOf(format);
+    if (index < this.#minimumIndex) return false;
+    return this.#pinnedFormat === null || this.#pinnedFormat === format;
+  }
+
+  reject(format: OpenAITTSResponseFormat): void {
+    const index = OPENAI_TTS_FORMAT_ORDER.indexOf(format);
+    if (index < 0) return;
+    this.#minimumIndex = Math.max(this.#minimumIndex, index + 1);
+    if (this.#pinnedFormat === format) this.#pinnedFormat = null;
+  }
+
+  pin(format: OpenAITTSResponseFormat): void {
+    const index = OPENAI_TTS_FORMAT_ORDER.indexOf(format);
+    if (index < this.#minimumIndex) return;
+    this.#minimumIndex = index;
+    this.#pinnedFormat = format;
+  }
+
+  async nextFormat(): Promise<OpenAITTSResponseFormat> {
+    if (this.#pinnedFormat) return this.#pinnedFormat;
+    for (let index = this.#minimumIndex; index < OPENAI_TTS_FORMAT_ORDER.length; index++) {
+      const format = OPENAI_TTS_FORMAT_ORDER[index]!;
+      if (index < this.#minimumIndex) continue;
+      const supported = await this.#probe(format);
+      // Another concurrent request may have rejected this format while its
+      // shared runtime probe was pending.
+      if (index < this.#minimumIndex) continue;
+      if (supported) return format;
+      this.reject(format);
+    }
+    throw new OpenAITTSCodecExhaustedError();
+  }
+
+  #probe(format: OpenAITTSResponseFormat): Promise<boolean> {
+    const existing = this.#probeResults.get(format);
+    if (existing) return existing;
+    const probe = new Promise<boolean>((resolve) => {
+      let done = false;
+      const finish = (supported: boolean) => {
+        if (done) return;
+        done = true;
+        clearTimeout(timer);
+        resolve(supported);
+      };
+      const timer = setTimeout(() => finish(false), CODEC_PROBE_TIMEOUT_MS);
+      this.#decode(getOpenAITTSProbeData(format)).then(
+        () => finish(true),
+        () => finish(false),
+      );
+    });
+    this.#probeResults.set(format, probe);
+    return probe;
+  }
+}
+
+export interface OpenAITTSFetchedAudio<TPayload extends OpenAITTSPayload = OpenAITTSPayload> {
+  format: OpenAITTSResponseFormat;
+  payload: TPayload;
+  audio: OpenAITTSAudioData;
