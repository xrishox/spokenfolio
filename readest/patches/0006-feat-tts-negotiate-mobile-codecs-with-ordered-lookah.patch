+
+// Decode the real sentence through the same decoder used by the probes. A
+// real-stream decode failure evicts those bytes, advances the ladder, and
+// refetches this same sentence. Other errors are deliberately left to fetch
+// and playback code so auth/rate-limit/network failures cannot pin a downgrade.
+export const decodeOpenAITTSAudioWithFallback = async <
+  TFetched extends OpenAITTSFetchedAudio,
+  TDecoded,
+>(
+  initial: TFetched,
+  options: {
+    negotiator: OpenAITTSCodecNegotiator;
+    decode: (data: ArrayBuffer) => Promise<TDecoded>;
+    refetch: () => Promise<TFetched>;
+    evict: (payload: TFetched['payload']) => void;
+  },
+): Promise<{ fetched: TFetched; decoded: TDecoded }> => {
+  let fetched = initial;
+  for (let attempt = 0; attempt <= OPENAI_TTS_FORMAT_ORDER.length; attempt++) {
+    if (!options.negotiator.accepts(fetched.format)) {
+      options.evict(fetched.payload);
+      fetched = await options.refetch();
+      continue;
+    }
+    try {
+      const decoded = await options.decode(fetched.audio.data);
+      options.negotiator.pin(fetched.format);
+      return { fetched, decoded };
+    } catch {
+      options.evict(fetched.payload);
+      options.negotiator.reject(fetched.format);
+      fetched = await options.refetch();
+    }
+  }
+  throw new OpenAITTSCodecExhaustedError();
+};
