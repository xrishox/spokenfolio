+import XCTest
+
+@testable import speech_server
+
+final class SiriTTSServiceTests: XCTestCase {
+    func testEveryInstalledExposedVariantProduces48KPCM() async throws {
+        let installed = SiriVoiceCatalog.discover()
+        guard !installed.isEmpty else {
+            throw XCTSkip("No compatible installed Siri neural/natural voices")
+        }
+        guard installed.count <= 4 else {
+            throw XCTSkip("This test host exposes more voices than the four-engine safety cap")
+        }
+
+        let service = try SiriTTSService()
+        try await service.initialize()
+        XCTAssertEqual(service.sampleRate, 48_000)
+        XCTAssertEqual(service.voiceCatalog.count, installed.count)
+
+        for voice in service.voiceCatalog {
+            let wav = try await service.synthesize(
+                text: "The rain had stopped, and the city was slowly waking.",
+                voice: voice.id)
+            XCTAssertGreaterThan(wav.count, 44, voice.id)
+            XCTAssertEqual(String(data: wav.prefix(4), encoding: .ascii), "RIFF")
+            XCTAssertEqual(wav.readUInt32LE(at: 24), 48_000, voice.id)
+            XCTAssertEqual(wav.readUInt16LE(at: 22), 1, voice.id)
+            XCTAssertEqual(wav.readUInt16LE(at: 34), 16, voice.id)
+        }
+    }
+}
+
+extension Data {
+    fileprivate func readUInt16LE(at offset: Int) -> UInt16 {
+        UInt16(self[offset]) | (UInt16(self[offset + 1]) << 8)
+    }
+
+    fileprivate func readUInt32LE(at offset: Int) -> UInt32 {
+        UInt32(self[offset])
+            | (UInt32(self[offset + 1]) << 8)
+            | (UInt32(self[offset + 2]) << 16)
+            | (UInt32(self[offset + 3]) << 24)
+    }
+}
