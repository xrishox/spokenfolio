+import XCTest
+import Yams
+
+@testable import speech_server
+
+final class SiriConfigTests: XCTestCase {
+    func testParseSiriEngine() throws {
+        let config = try YAMLDecoder().decode(
+            ServerConfig.self,
+            from: "tts:\n  engine: siri\n")
+        XCTAssertEqual(config.tts.engine, .siri)
+    }
+
+    func testSiriSettingsDefaults() {
+        let settings = SiriSettings()
+        XCTAssertNil(settings.defaultVoice)
+        XCTAssertEqual(settings.maxLoadedVoices, 4)
+        XCTAssertEqual(settings.maxConcurrentSyntheses, 4)
+        XCTAssertEqual(settings.maxQueuedRequests, 20)
+    }
+
+    func testParseAllSiriSettings() throws {
+        let yaml = """
+            tts:
+              engine: siri
+              siri:
+                default_voice: com.apple.siri.tts.voice.en_US.nora.natural.premium
+                max_loaded_voices: 2
+                max_concurrent_syntheses: 2
+                max_queued_requests: 8
+            """
+        let config = try YAMLDecoder().decode(ServerConfig.self, from: yaml)
+        XCTAssertEqual(config.tts.siri?.defaultVoice, "com.apple.siri.tts.voice.en_US.nora.natural.premium")
+        XCTAssertEqual(config.tts.siri?.maxLoadedVoices, 2)
+        XCTAssertEqual(config.tts.siri?.maxConcurrentSyntheses, 2)
+        XCTAssertEqual(config.tts.siri?.maxQueuedRequests, 8)
+    }
+}
