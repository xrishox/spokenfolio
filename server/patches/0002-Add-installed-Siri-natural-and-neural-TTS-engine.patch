+struct SiriSettings: Codable, Sendable {
+    /// Canonical catalog ID, display name, or unambiguous short name.
+    /// Nil selects the best natural/neural voice for the current locale.
+    var defaultVoice: String?
+    /// Private engines remain resident because teardown is unstable. The hard
+    /// implementation ceiling is four; lower values are useful on small Macs.
+    var maxLoadedVoices: Int
+    /// Maximum number of different voice lanes synthesizing simultaneously.
+    var maxConcurrentSyntheses: Int
+    /// Requests waiting behind the active/voice-serial limits.
+    var maxQueuedRequests: Int
+
+    init() {
+        defaultVoice = nil
+        maxLoadedVoices = 4
+        maxConcurrentSyntheses = 4
+        maxQueuedRequests = 20
+    }
+
+    init(from decoder: any Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        defaultVoice = try c.decodeIfPresent(String.self, forKey: .defaultVoice)
+        maxLoadedVoices = try c.decodeIfPresent(Int.self, forKey: .maxLoadedVoices) ?? 4
+        maxConcurrentSyntheses =
+            try c.decodeIfPresent(Int.self, forKey: .maxConcurrentSyntheses) ?? 4
+        maxQueuedRequests = try c.decodeIfPresent(Int.self, forKey: .maxQueuedRequests) ?? 20
+    }
+
+    enum CodingKeys: String, CodingKey {
+        case defaultVoice = "default_voice"
+        case maxLoadedVoices = "max_loaded_voices"
+        case maxConcurrentSyntheses = "max_concurrent_syntheses"
+        case maxQueuedRequests = "max_queued_requests"
+    }
+}
