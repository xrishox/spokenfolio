+import Foundation
+import XCTest
+
+@testable import speech_server
+
+final class SiriVoiceCatalogTests: XCTestCase {
+    private var temporaryDirectories: [URL] = []
+
+    override func tearDown() {
+        for directory in temporaryDirectories {
+            try? FileManager.default.removeItem(at: directory)
+        }
+        temporaryDirectories.removeAll()
+        super.tearDown()
+    }
+
+    func testUAFUsesOuterAssetSpecifierAndInnerEnginePath() throws {
+        let root = try makeTemporaryDirectory()
+        let id = "com.apple.siri.tts.voice.en_US.nora.natural.premium"
+        let asset = try makeUAFAsset(
+            under: root,
+            folder: "natural.asset",
+            id: id,
+            type: "natural",
+            version: 5068,
+            outputRate: 48_000,
+            styles: ["siri", "narration"])
+
+        let voices = SiriVoiceCatalog.discover(searchDirectories: [root])
+        XCTAssertEqual(voices.count, 1)
+        XCTAssertEqual(voices[0].id, id)
+        XCTAssertEqual(
+            resolvedPath(voices[0].voicePath),
+            asset.appendingPathComponent("AssetData").resolvingSymlinksInPath().path)
+        XCTAssertEqual(
+            resolvedPath(voices[0].resourcePath),
+            asset.appendingPathComponent("AssetData").resolvingSymlinksInPath().path)
+        XCTAssertTrue(voices[0].supportsNarration)
+    }
+
+    func testNon48KAssetIsNotExposed() throws {
+        let root = try makeTemporaryDirectory()
+        _ = try makeUAFAsset(
+            under: root,
+            folder: "bad.asset",
+            id: "com.apple.siri.tts.voice.en_US.nora.neural.premium",
+            type: "neural",
+            version: 1,
+            outputRate: 24_000,
+            styles: [])
+        XCTAssertTrue(SiriVoiceCatalog.discover(searchDirectories: [root]).isEmpty)
+    }
+
+    func testDuplicateTrialAssetKeepsFirstCanonicalUAFID() throws {
+        let uafRoot = try makeTemporaryDirectory()
+        let trialRoot = try makeTemporaryDirectory()
+        let expected = "com.apple.siri.tts.voice.en_US.nora.neural.premium"
+        _ = try makeUAFAsset(
+            under: uafRoot, folder: "uaf.asset", id: expected,
+            type: "neural", version: 1899, outputRate: 48_000, styles: [])
+        _ = try makeUAFAsset(
+            under: trialRoot, folder: "trial.asset",
+            id: "\(expected)-en_US-iPhone",
+            type: "neural", version: 1899, outputRate: 48_000, styles: [])
+
+        let voices = SiriVoiceCatalog.discover(searchDirectories: [uafRoot, trialRoot])
+        XCTAssertEqual(voices.count, 1)
+        XCTAssertEqual(voices[0].id, expected)
+    }
+
+    func testLegacyRootUsesSeparateResourceDirectory() throws {
+        let root = try makeTemporaryDirectory()
+        let voiceRoot = root.appendingPathComponent("Nora Legacy", isDirectory: true)
+        let resources = voiceRoot.appendingPathComponent("AssetData", isDirectory: true)
+        try FileManager.default.createDirectory(at: resources, withIntermediateDirectories: true)
+        var legacyProperties = voiceProperties(
+            type: "gryphon", version: 7, styles: ["narration"])
+        legacyProperties.removeValue(forKey: "_ContentVersion")
+        try writePlist(
+            [
+                "CFBundleIdentifier": "com.apple.MobileAsset.VoiceServices.GryphonVoice",
+                "CFBundleName": "nora_legacy",
+                "CFBundleVersion": "42.1",
+                "MobileAssetProperties": legacyProperties,
+            ],
+            to: voiceRoot.appendingPathComponent("Info.plist"))
+        try writeJSON(
+            ["pipeline": [["params": ["sample_rate_out": 48_000]]]],
+            to: resources.appendingPathComponent("gryphon.cfg"))
+
+        let voices = SiriVoiceCatalog.discover(searchDirectories: [root])
+        XCTAssertEqual(voices.count, 1)
+        XCTAssertEqual(resolvedPath(voices[0].voicePath), voiceRoot.resolvingSymlinksInPath().path)
+        XCTAssertEqual(
+            resolvedPath(voices[0].resourcePath), resources.resolvingSymlinksInPath().path)
+        XCTAssertEqual(
+            voices[0].id,
+            "com.apple.MobileAsset.VoiceServices.GryphonVoice.nora_legacy")
+        XCTAssertEqual(voices[0].version, 42)
+    }
+
+    private func makeUAFAsset(
+        under root: URL,
+        folder: String,
+        id: String,
+        type: String,
+        version: Int,
+        outputRate: Int,
+        styles: [String]
+    ) throws -> URL {
+        let asset = root.appendingPathComponent(folder, isDirectory: true)
+        let engine = asset.appendingPathComponent("AssetData", isDirectory: true)
+        try FileManager.default.createDirectory(at: engine, withIntermediateDirectories: true)
+        try writePlist(
+            ["MobileAssetProperties": ["AssetSpecifier": id]],
+            to: asset.appendingPathComponent("Info.plist"))
+        try writePlist(
+            [
+                "CFBundleIdentifier": "com.apple.MobileAsset.VoiceServices.GryphonVoice",
+                "CFBundleName": "nora_\(version)",
+                "MobileAssetProperties": voiceProperties(
+                    type: type, version: version, styles: styles),
+            ],
+            to: engine.appendingPathComponent("Info.plist"))
+        try writeJSON(
+            ["pipeline": [["params": ["sample_rate_out": outputRate]]]],
+            to: engine.appendingPathComponent("gryphon.cfg"))
+        return asset
+    }
+
+    private func voiceProperties(type: String, version: Int, styles: [String]) -> [String: Any] {
+        [
+            "Type": type,
+            "Name": "nora",
+            "Footprint": "premium",
+            "_ContentVersion": version,
+            "LanguagesCompatibility": ["en_US"],
+            "Styles": styles,
+        ]
+    }
+
+    private func makeTemporaryDirectory() throws -> URL {
+        let url = FileManager.default.temporaryDirectory
+            .appendingPathComponent("SiriVoiceCatalogTests-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        temporaryDirectories.append(url)
+        return url
+    }
+
+    private func writePlist(_ value: Any, to url: URL) throws {
+        let data = try PropertyListSerialization.data(
+            fromPropertyList: value, format: .xml, options: 0)
+        try data.write(to: url)
+    }
+
+    private func writeJSON(_ value: Any, to url: URL) throws {
+        try JSONSerialization.data(withJSONObject: value).write(to: url)
+    }
+
+    private func resolvedPath(_ path: String) -> String {
+        URL(fileURLWithPath: path).resolvingSymlinksInPath().path
+    }
+}
