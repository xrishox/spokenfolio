+import XCTest
+import Yams
+
+@testable import speech_server
+
+/// Tests for the fork additions: the voice catalog / resolveVoice surface
+/// and the `stt.engine: none` configuration.
+final class VoiceCatalogTests: XCTestCase {
+    private var service: AVSpeechTTSService!
+
+    override func setUp() {
+        super.setUp()
+        service = AVSpeechTTSService()
+    }
+
+    // MARK: - Voice catalog
+
+    func testVoiceCatalogNotEmpty() {
+        XCTAssertFalse(service.voiceCatalog.isEmpty, "macOS must have at least one system voice")
+    }
+
+    func testVoiceCatalogIdsAreUnique() {
+        let ids = service.voiceCatalog.map { $0.id }
+        XCTAssertEqual(ids.count, Set(ids).count, "catalog ids (identifiers) must be unique")
+    }
+
+    func testVoiceCatalogEntriesHaveNameLangQuality() {
+        for voice in service.voiceCatalog {
+            XCTAssertFalse(voice.id.isEmpty)
+            XCTAssertFalse(voice.name.isEmpty)
+            XCTAssertFalse(voice.lang.isEmpty)
+            XCTAssertTrue(["default", "enhanced", "premium"].contains(voice.quality))
+        }
+    }
+
+    func testEveryCatalogIdResolves() {
+        for voice in service.voiceCatalog {
+            XCTAssertEqual(
+                service.resolveVoice(voice.id), voice.id,
+                "catalog id '\(voice.id)' must resolve to itself"
+            )
+        }
+    }
+
+    // MARK: - resolveVoice
+
+    func testResolveVoiceByNameCaseInsensitive() {
+        let name = service.availableVoices[0]
+        let resolved = service.resolveVoice(name.lowercased())
+        XCTAssertNotNil(resolved)
+        XCTAssertEqual(resolved, service.resolveVoice(name.uppercased()))
+    }
+
+    func testResolveUnknownVoiceReturnsNil() {
+        XCTAssertNil(service.resolveVoice("definitely-not-a-voice-xyz"))
+    }
+
+    func testDefaultResolveVoiceFallback() {
+        // Engines without an override get exact-match semantics via the protocol extension.
+        let mock = MockTTSService()
+        XCTAssertEqual(mock.resolveVoice(mock.availableVoices[0]), mock.availableVoices[0])
+        XCTAssertNil(mock.resolveVoice("nope"))
+    }
+
+    func testDefaultVoiceCatalogFallback() {
+        let mock = MockTTSService()
+        XCTAssertEqual(mock.voiceCatalog.map { $0.id }, mock.availableVoices)
+    }
+
+    // MARK: - stt.engine: none
+
+    func testSTTEngineNoneParses() throws {
+        let yaml = """
+            stt:
+              engine: none
+            """
+        let config = try YAMLDecoder().decode(ServerConfig.self, from: yaml)
+        XCTAssertEqual(config.stt.engine, .none)
+    }
+
+    func testDisabledSTTServiceThrows() async {
+        let service = DisabledSTTService()
+        do {
+            _ = try await service.transcribe(audioURL: URL(fileURLWithPath: "/dev/null"))
+            XCTFail("DisabledSTTService must throw")
+        }
+        catch {
+            // expected
+        }
+    }
+}
