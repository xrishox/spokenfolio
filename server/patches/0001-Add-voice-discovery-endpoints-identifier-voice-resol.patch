diff --git a/Sources/speech-server/Services/AVSpeechTTSService.swift b/Sources/speech-server/Services/AVSpeechTTSService.swift
index 5830351..80ec03c 100644
--- a/Sources/speech-server/Services/AVSpeechTTSService.swift
+++ b/Sources/speech-server/Services/AVSpeechTTSService.swift
@@ -19,6 +19,7 @@ final class AVSpeechTTSService: TTSService, Sendable {
     let sampleRate: Int
     let defaultVoice: String
     let availableVoices: [String]
+    let voiceCatalog: [VoiceInfo]
 
     // Maps lowercase voice name or full identifier -> canonical identifier.
     private let voiceLookup: [String: String]
@@ -41,6 +42,22 @@ final class AVSpeechTTSService: TTSService, Sendable {
         let nameSet = Set(voices.map { $0.name })
         self.availableVoices = nameSet.sorted()
 
+        // Full catalog, one entry per identifier so same-named voices
+        // (language variants, enhanced/premium tiers) stay distinguishable.
+        self.voiceCatalog =
+            voices
+            .map { voice in
+                let quality: String =
+                    switch voice.quality {
+                    case .enhanced: "enhanced"
+                    case .premium: "premium"
+                    default: "default"
+                    }
+                return VoiceInfo(
+                    id: voice.identifier, name: voice.name, lang: voice.language, quality: quality)
+            }
+            .sorted { ($0.lang, $0.name, $0.quality) < ($1.lang, $1.name, $1.quality) }
+
         // Resolve the default voice: config > system locale default > first available.
         if let configVoice = settings.defaultVoice {
             self.defaultVoice = configVoice
@@ -67,6 +84,12 @@ final class AVSpeechTTSService: TTSService, Sendable {
 
     // MARK: - TTSService
 
+    /// Accepts case-insensitive short names ("samantha") and full identifiers
+    /// ("com.apple.voice.enhanced.en-US.Samantha"); returns the canonical identifier.
+    func resolveVoice(_ voice: String) -> String? {
+        voiceLookup[voice.lowercased()]
+    }
+
     /// Synthesises all sentences, accumulates Float32 samples, applies peak normalisation,
     /// and returns a complete WAV file.
     func synthesize(text: String, voice: String) async throws -> Data {
diff --git a/Sources/speech-server/Services/STTService.swift b/Sources/speech-server/Services/STTService.swift
index 059a0f0..1f7577b 100644
--- a/Sources/speech-server/Services/STTService.swift
+++ b/Sources/speech-server/Services/STTService.swift
@@ -26,6 +26,14 @@ protocol STTService: Sendable {
     func transcribe(audioURL: URL) async throws -> TranscriptionResult
 }
 
+/// Used when `stt.engine: none` — a TTS-only deployment with no ASR models loaded.
+/// Transcription requests fail with 503 instead of crashing on a missing service.
+struct DisabledSTTService: STTService {
+    func transcribe(audioURL: URL) async throws -> TranscriptionResult {
+        throw Abort(.serviceUnavailable, reason: "STT is disabled on this server (stt.engine: none).")
+    }
+}
+
