diff --git a/Sources/speech-server/Controllers/VoicesController.swift b/Sources/speech-server/Controllers/VoicesController.swift
new file mode 100644
index 0000000..903d7cd
--- /dev/null
+++ b/Sources/speech-server/Controllers/VoicesController.swift
@@ -0,0 +1,65 @@
+import Vapor
+
+/// Voice discovery and OpenAI-compatible model listing.
+///
+/// - `GET /audio/voices` (and `/v1/audio/voices`): flat list of voice identifiers,
+///   shape-compatible with Kokoro-FastAPI-style clients (`{"voices": ["id", ...]}`).
+/// - `GET /audio/voices/all` (and `/v1/audio/voices/all`): full catalog with
+///   display name, language, and quality tier per voice.
+/// - `GET /models` (and `/v1/models`): static OpenAI-style model list; OpenAI TTS
+///   clients commonly probe this endpoint as a health check.
+struct VoicesController: RouteCollection {
+    func boot(routes: any RoutesBuilder) throws {
+        routes.get("audio", "voices", use: listVoiceIds)
+        routes.get("audio", "voices", "all", use: listVoiceCatalog)
+        routes.get("models", use: listModels)
+    }
+
+    struct VoiceIdsResponse: Content {
+        let voices: [String]
+    }
+
+    struct VoiceCatalogResponse: Content {
+        let voices: [VoiceInfo]
+    }
+
+    struct ModelObject: Content {
+        let id: String
+        let object: String
+        let created: Int
+        let ownedBy: String
+
+        enum CodingKeys: String, CodingKey {
+            case id
+            case object
+            case created
+            case ownedBy = "owned_by"
+        }
+    }
+
+    struct ModelListResponse: Content {
+        let object: String
+        let data: [ModelObject]
+    }
+
+    @Sendable
+    func listVoiceIds(req: Request) async throws -> VoiceIdsResponse {
+        VoiceIdsResponse(voices: req.ttsService.voiceCatalog.map { $0.id })
+    }
+
+    @Sendable
+    func listVoiceCatalog(req: Request) async throws -> VoiceCatalogResponse {
+        VoiceCatalogResponse(voices: req.ttsService.voiceCatalog)
+    }
+
+    @Sendable
+    func listModels(req: Request) async throws -> ModelListResponse {
+        ModelListResponse(
+            object: "list",
+            data: [
+                ModelObject(id: "tts-1", object: "model", created: 0, ownedBy: "speech-server"),
+                ModelObject(id: "tts-1-hd", object: "model", created: 0, ownedBy: "speech-server"),
+            ]
+        )
+    }
+}
